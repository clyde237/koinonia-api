{
  "name": "koinonia-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:check": "node --import tsx src/db-check.ts",
    "db:migrate": "node --import tsx src/migrate.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "RUN_DATABASE_TESTS=1 node --import tsx --test --test-concurrency=1 tests/*.integration.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@neondatabase/serverless": "^1.2.1",
    "dotenv": "^17.2.3",
    "hono": "^4.10.0",
    "jose": "^6.2.17",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
